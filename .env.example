# Copy this file to .env and change the values. Do not commit .env.

# Database
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/smartfarm

# Access tokens. Keep the secret private. A new secret logs out all users.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Login and verification
ONE_TIME_TOKEN_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
VERIFICATION_MAX_FAILURES=5

# Password of the first admin (johndoe) that POST /seed-data makes.
# If it is empty, the seed makes a random password and prints it in the server log.
SEED_ADMIN_PASSWORD=change-me

# Addresses of the React client, as a JSON list
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Version of the privacy text that the registration form shows
PRIVACY_POLICY_VERSION=1.0
